{
    "manifest_version": 3,
    "name": "Youtube Enhancement And Helper",
    "version": "2.7.6",
    "description": "Customize some aspects of YouTube display.",
    "homepage_url": "https://github.com/NekoZ410/Youtube_Enhancement_And_Helper",
    "permissions": ["activeTab", "storage"],
    "host_permissions": ["*://*.youtube.com/*"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icons/icon16.png",
            "32": "images/icons/icon32.png",
            "48": "images/icons/icon64.png",
            "64": "images/icons/icon64.png",
            "128": "images/icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["DEFAULT_SETTINGS.js", "MAIN_SELECTORS.js", "content-core.js", "content-ui.js", "content-texts.js", "content-player.js", "content-utilities.js"],
            "run_at": "document_start"
        },
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["content-utilities-mainWorld.js"],
            "run_at": "document_start",
            "world": "MAIN" 
        },
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["./test/content-experiment.js"],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}
